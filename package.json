{
  "name": "matias-storage",
  "version": "0.3.0",
  "description": "A zero-dependency Web Storage wrapper: automatic JSON serialization, lossless Date/Map/Set/RegExp/BigInt round-trips, typed keys with TS inference, and optional runtime validation on read.",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "files": [
    "dist"
  ],
  "module": "./dist/index.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "ts:build": "tsc --build src/storage/tsconfig.json",
    "build": "vite --config vite.build.config.ts build --mode production",
    "cp:types": "node -e \"require('fs').cpSync('src/storage/types','dist/types',{recursive:true})\"",
    "plugin:build": "pnpm run ts:build && pnpm run build && pnpm run cp:types",
    "publish:npm": "pnpm run plugin:build && npm publish --registry https://registry.npmjs.org"
  },
  "keywords": [
    "storage",
    "web-storage",
    "localstorage",
    "sessionstorage",
    "json",
    "serialize",
    "serialize-deserialize",
    "typescript",
    "typed",
    "zero-dependency",
    "matias-storage",
    "matiastang"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matiastang/web-storage.git"
  },
  "author": {
    "name": "matiastang",
    "email": "matiastang@163.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/matiastang/web-storage/issues"
  },
  "homepage": "https://github.com/matiastang/web-storage#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.10",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "less": "^4.2.0",
    "prettier": "^3.9.6",
    "rollup-plugin-minification": "^0.2.0",
    "tslib": "^2.6.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.3.3",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^2.1.9",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0"
  }
}
