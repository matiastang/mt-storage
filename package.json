{
  "name": "matias-storage",
  "version": "0.3.0",
  "description": "web storage的简单封装",
  "main": "./dist/index.umd.js",
  "files": [
    "dist"
  ],
  "module": "./dist/index.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "ts:build": "tsc --build src/storage/tsconfig.json",
    "build": "vite --config vite.build.config.ts build --mode production",
    "cp:types": "node -e \"require('fs').cpSync('src/storage/types','dist/types',{recursive:true})\"",
    "plugin:build": "pnpm run ts:build && pnpm run build && pnpm run cp:types",
    "publish:npm": "pnpm run plugin:build && npm publish --registry https://registry.npmjs.org"
  },
  "keywords": [
    "matias",
    "matiastang",
    "storage",
    "matias-storage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matiastang/mt-storage.git"
  },
  "author": {
    "name": "matiastang",
    "email": "matiastang@163.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/matiastang/mt-storage/issues"
  },
  "homepage": "https://github.com/matiastang/mt-storage#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.7.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "less": "^4.2.0",
    "rollup-plugin-minification": "^0.2.0",
    "tslib": "^2.6.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^2.1.9",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0"
  }
}
